rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(authorIdField) {
      return isSignedIn() && request.auth.uid == authorIdField;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'shufalharvest@gmail.com';
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function canPost() {
      return isAdmin() || getUserRole() == 'farmer' || getUserRole() == 'trader';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if canPost() && request.resource.data.farmerId == request.auth.uid;
      allow update: if isSignedIn() && (
        isOwner(resource.data.farmerId) || isAdmin() ||
        // Allow updating bid fields for any signed in user
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBid', 'highestBidderId', 'highestBidderName']) &&
         request.resource.data.currentBid > resource.data.currentBid)
      );
      allow delete: if isOwner(resource.data.farmerId) || isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isOwner(resource.data.authorId) || isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) && 
         request.resource.data.likes == resource.data.likes + 1)
      );
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isOwner(resource.data.authorId) || isAdmin();
      allow delete: if isOwner(resource.data.authorId) || isAdmin();
    }

    match /marketPrices/{priceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
